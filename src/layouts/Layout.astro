---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Hombres lobo online' } = Astro.props;
---

<!doctype html>
<html lang="es" data-tema="castronegro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0c18" />
    <meta name="application-name" content="La Aldea Maldita" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/iconos/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="La Aldea Maldita" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <title>{title}</title>
  </head>
  <body>
    <main class="mx-auto flex w-full max-w-md flex-col gap-6 px-4 py-8">
      <slot />
    </main>
    <script is:inline>
      // PWA: el service worker solo en producción, para no estorbar en `astro dev`.
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
  </body>
</html>
