# Copia este archivo a .env y rellena los valores de tu proyecto de Supabase.
# Nunca commitees el archivo .env con claves reales.
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# Modo pruebas: permite empezar en modo clásico con menos de 6 jugadores.
# Desactivado si no se define. No lo actives en producción.
# PUBLIC_MODO_PRUEBAS=true
